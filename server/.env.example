# Cache/Valkey Configuration
CACHE_ADDR=urlvet-valkey-dev:6379 # urlvet-valkey:6379
CACHE_PASSWORD=
CACHE_DB=0
CACHE_POOL_SIZE=50
CACHE_MIN_IDLE_CONNS=10

# Server Configuration
ENV=DEV
PORT=8080
LOG_TIMEZONE=UTC          # e.g. Asia/Kolkata, America/New_York, Europe/London
LOG_DIR=logs              # directory for rotating daily log files; leave empty to disable
REPORTS_FILE=data/reports.jsonl  # user-submitted "wrong result" reports, one JSON object per line
CORS_ALLOWED_ORIGINS=https://url.vet
ADMIN_PASSWORD_HASH=''                   # use single quotes — see docs/security.md for how to generate
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=

# Threat feeds — see docs/configuration.md for each feed's licence.
# (Comments sit on their own lines: an empty value followed by "# …" is read
# as the value.)
# PhishTank's list is on by default (free, commercial use OK); 0 turns it off.
FEED_PHISHTANK=
# Optional: hourly instead of 6-hourly refreshes (registration is currently closed).
PHISHTANK_API_KEY=
# PhishTank asks for "phishtank/<your username>".
PHISHTANK_USER_AGENT=
# abuse.ch malware URLs. Free key, no card, at https://auth.abuse.ch; not-for-profit use.
URLHAUS_AUTH_KEY=
# Google Safe Browsing v5. Free, no billing account; non-commercial use only.
SAFE_BROWSING_API_KEY=
# Google Web Risk. Commercial use; needs a billing account (100k lookups/month free).
WEBRISK_API_KEY=
# 1 enables OpenPhish's community feed; its terms allow personal research only.
FEED_OPENPHISH=
# Where downloaded lists are cached between restarts.
FEEDS_DIR=data/feeds
# 0 switches every threat lookup off (lists, PhishTank, Safe Browsing, Web
# Risk), whatever keys are set. For batch tests of the scanner's own checks.
THREAT_LOOKUPS=
